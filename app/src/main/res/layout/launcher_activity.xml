<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/launcherBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/mainBgColor">

        <!-- 顶部时间区：文本居中，电量固定在右上角 -->
        <FrameLayout
            android:id="@+id/largeClockContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp">

            <LinearLayout
                android:id="@+id/largeClockTextContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:weightSum="4">

                <TextView
                    android:id="@+id/largeClockTime"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3"
                    android:gravity="bottom|center_horizontal"
                    android:fontFamily="@font/zyymeclock"
                    android:textColor="@color/textColor"
                    android:textSize="1sp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/largeClockDate"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="top|center_horizontal"
                    android:textColor="@color/textColor"
                    android:textSize="1sp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:clickable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topBatteryContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|right"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <!-- 只保留圆圈内百分比，不再单独显示一行百分比文字 -->
                <cn.modificator.launcher.widgets.BatteryView
                    android:id="@+id/topBatteryProgress"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:clickable="true" />
            </LinearLayout>
        </FrameLayout>

        <!-- 分隔线 1：宽度由代码按日期文字宽度设置 -->
        <View
            android:id="@+id/topDivider"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/dividerColor" />

        <!-- 应用图标区：固定两行 -->
        <cn.modificator.launcher.widgets.EInkLauncherView
            android:id="@+id/mList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="6dp" />

        <!-- 页面小点 -->
        <LinearLayout
            android:id="@+id/pageIndicator"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- 分隔线 2：通栏 -->
        <View
            android:id="@+id/bottomDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@color/dividerColor" />

        <!-- Dock：四个槽位，贴屏幕底部 -->
        <LinearLayout
            android:id="@+id/dockContainer"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">

            <FrameLayout
                android:id="@+id/dockSlot0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/dockSlot1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/dockSlot2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/dockSlot3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 旧页脚：保留 ID 兼容原有逻辑，整体隐藏 -->
        <FrameLayout
            android:id="@+id/footerContainer"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/footerContent"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/pageStatus"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1/1"
                    android:textColor="@color/textColor"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textClock"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/footer_item_focus"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:textColor="@color/textColor"
                    android:textSize="16sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/batteryContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="5dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <cn.modificator.launcher.widgets.BatteryView
                        android:id="@+id/batteryProgress"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@drawable/footer_item_focus" />

                    <TextView
                        android:id="@+id/batteryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="充电中"
                        android:textColor="@color/textColor"
                        android:textSize="9sp"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/toSetting"
                    android:layout_width="60dp"
                    android:layout_height="45dp"
                    android:background="@drawable/footer_item_focus"
                    android:clickable="true"
                    android:padding="10dp"
                    android:src="@drawable/navibar_icon_settings_highlight" />

                <Button
                    android:id="@+id/lastPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Page"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/nextPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Page"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/deleteFinish"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:clickable="true"
                android:gravity="center"
                android:text="@string/app_manager_finish"
                android:textSize="18sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 操作提示条：排序/清理结果等短提示，避免 Toast 在墨水屏上不可见 -->
    <TextView
        android:id="@+id/statusHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@color/mainBgColor"
        android:clickable="false"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/textColor"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- SettingFragment 覆盖层 -->
    <FrameLayout
        android:id="@+id/settingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
